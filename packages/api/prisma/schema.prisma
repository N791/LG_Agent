generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  MENTOR
  TRAINEE
}

enum TaskType {
  MANDATORY
  ELECTIVE
}

enum TaskDifficulty {
  BEGINNER
  INTERMEDIATE
  ADVANCED
}

model Organization {
  id        String   @id @default(uuid()) @db.Uuid
  name      String   @db.VarChar
  code      String   @unique @db.VarChar
  status    Int      @default(1) @db.SmallInt
  createdAt DateTime @default(now()) @map("created_at")

  users         User[]
  courses       Course[]
  conversations Conversation[]

  @@map("organizations")
}

model User {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @map("organization_id") @db.Uuid
  username       String       @unique @db.VarChar
  password       String       @db.VarChar
  nickname       String?      @db.VarChar
  email          String?      @db.VarChar
  role           Role         @default(TRAINEE)
  status         Int          @default(1) @db.SmallInt
  createdAt      DateTime     @default(now()) @map("created_at")

  organization   Organization @relation(fields: [organizationId], references: [id])

  coursesCreated Course[]       @relation("CourseCreator")
  submissions    Submission[]
  llmRequestLogs LlmRequestLog[]
  conversations  Conversation[]
  workspaces     Workspace[]

  @@map("users")
}

model Course {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @map("organization_id") @db.Uuid
  title          String       @db.VarChar
  description    String?      @db.Text
  version        String       @db.VarChar
  status         Int          @default(0) @db.SmallInt // 0: 草稿, 1: 已发布
  createdById    String       @map("created_by") @db.Uuid
  createdAt      DateTime     @default(now()) @map("created_at")

  organization   Organization @relation(fields: [organizationId], references: [id])
  createdBy      User         @relation("CourseCreator", fields: [createdById], references: [id])
  tasks          Task[]

  @@map("courses")
}

model Task {
  id             String       @id @default(uuid()) @db.Uuid
  courseId       String       @map("course_id") @db.Uuid
  title          String         @db.VarChar
  summary        String?        @db.VarChar // 任务摘要（列表展示）
  description    String?        @db.Text    // Markdown 任务内容
  stage          Int            @db.Integer
  taskType       TaskType       @default(MANDATORY) @map("task_type")
  difficulty     TaskDifficulty @default(BEGINNER)
  version        Int            @default(1) @db.Integer
  envConfig      Json           @map("env_config") @db.JsonB
  sandboxConfig  Json           @map("sandbox_config") @db.JsonB
  testConfig     Json           @map("test_config") @db.JsonB
  promptConfig   Json           @map("prompt_config") @db.JsonB
  config         Json?          @db.JsonB
  metadata       Json?          @db.JsonB

  course         Course         @relation(fields: [courseId], references: [id])
  submissions    Submission[]
  conversations  Conversation[]
  workspaces     Workspace[]

  @@map("tasks")
}

model Submission {
  id             String       @id @default(uuid()) @db.Uuid
  taskId         String       @map("task_id") @db.Uuid
  userId         String       @map("user_id") @db.Uuid
  status         String       @default("PENDING") @db.VarChar // PENDING, RUNNING, PASSED, FAILED
  score          Int          @default(0) @db.SmallInt
  logs           String?      @db.Text
  report         Json?        @db.JsonB
  createdAt      DateTime     @default(now()) @map("created_at")

  task           Task         @relation(fields: [taskId], references: [id])
  user           User         @relation(fields: [userId], references: [id])

  @@map("submissions")
}

model LlmRequestLog {
  id               String   @id @default(uuid()) @db.Uuid
  requestId        String   @map("request_id") @db.VarChar
  provider         String   @db.VarChar
  model            String   @db.VarChar
  promptHash       String?  @map("prompt_hash") @db.VarChar
  userId           String?  @map("user_id") @db.Uuid
  conversationId   String?  @map("conversation_id") @db.Uuid
  requestType      String   @map("request_type") @db.VarChar
  latency          Int      @db.Integer
  promptTokens     Int      @map("prompt_tokens") @db.Integer
  completionTokens Int      @map("completion_tokens") @db.Integer
  totalTokens      Int      @map("total_tokens") @db.Integer
  estimatedCost    Float    @map("estimated_cost") @db.DoublePrecision
  status           String   @db.VarChar
  createdAt        DateTime @default(now()) @map("created_at")

  user             User?    @relation(fields: [userId], references: [id])

  @@map("llm_request_logs")
}

model LlmAuditLog {
  id             String   @id @default(uuid()) @db.Uuid
  requestId      String   @map("request_id") @db.VarChar
  eventType      String   @map("event_type") @db.VarChar
  severity       String   @db.VarChar
  action         String   @db.VarChar
  message        String   @db.Text
  metadata       Json?    @db.JsonB
  createdAt      DateTime @default(now()) @map("created_at")

  @@map("llm_audit_logs")
}

model Conversation {
  id             String                @id @default(uuid()) @db.Uuid
  organizationId String                @map("organization_id") @db.Uuid
  userId         String                @map("user_id") @db.Uuid
  taskId         String                @map("task_id") @db.Uuid
  status         String                @default("ACTIVE") @db.VarChar
  createdAt      DateTime              @default(now()) @map("created_at")
  updatedAt      DateTime              @updatedAt @map("updated_at")

  organization   Organization          @relation(fields: [organizationId], references: [id])
  user           User                  @relation(fields: [userId], references: [id])
  task           Task                  @relation(fields: [taskId], references: [id])
  messages       ConversationMessage[]

  @@map("conversations")
}

model ConversationMessage {
  id             String       @id @default(uuid()) @db.Uuid
  conversationId String       @map("conversation_id") @db.Uuid
  role           String       @db.VarChar // USER, ASSISTANT, SYSTEM
  content        String       @db.Text
  model          String?      @db.VarChar
  tokenUsage     Int?         @map("token_usage") @db.Integer
  metadata       Json?        @db.JsonB
  createdAt      DateTime     @default(now()) @map("created_at")

  conversation   Conversation @relation(fields: [conversationId], references: [id])

  @@map("conversation_messages")
}

model Workspace {
  id        String             @id @default(uuid()) @db.Uuid
  userId    String             @map("user_id") @db.Uuid
  taskId    String             @map("task_id") @db.Uuid
  status    String             @default("DRAFT") @db.VarChar // DRAFT, ACTIVE, ARCHIVED
  createdAt DateTime           @default(now()) @map("created_at")
  updatedAt DateTime           @updatedAt @map("updated_at")

  user      User               @relation(fields: [userId], references: [id])
  task      Task               @relation(fields: [taskId], references: [id])
  files     WorkspaceFile[]
  versions  WorkspaceVersion[]

  @@unique([userId, taskId])
  @@map("workspaces")
}

model WorkspaceFile {
  id          String    @id @default(uuid()) @db.Uuid
  workspaceId String    @map("workspace_id") @db.Uuid
  path        String    @db.VarChar
  content     String    @db.Text
  language    String?   @db.VarChar
  encoding    String?   @db.VarChar
  readonly    Boolean   @default(false)
  hidden      Boolean   @default(false)
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, path])
  @@map("workspace_files")
}

model WorkspaceVersion {
  id          String    @id @default(uuid()) @db.Uuid
  workspaceId String    @map("workspace_id") @db.Uuid
  version     Int       @db.Integer
  trigger     String    @db.VarChar // RUN, SUBMIT, MANUAL
  snapshot    Json      @db.JsonB // Stores the file snapshot
  createdAt   DateTime  @default(now()) @map("created_at")

  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@map("workspace_versions")
}


