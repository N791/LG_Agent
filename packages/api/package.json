{
  "name": "@lg-agent/api",
  "version": "1.0.0",
  "private": true,
  "description": "AI 沉浸式入职引擎 — 后端 API 服务（NestJS）",
  "scripts": {
    "build": "nest build",
    "start": "nest start",
    "dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "test": "jest --passWithNoTests",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:retrieval-gate": "jest --runInBand src/modules/ai/retrieval/epic79.spec.ts src/modules/ai/retrieval/epic77.spec.ts src/modules/ai/conversation/epic78.spec.ts src/modules/ai/retrieval/document/hybrid-document-retriever.adapter.spec.ts src/modules/ai/retrieval/code/repository-code-intelligence.spec.ts",
    "db:init": "node scripts/init-database.mjs",
    "prisma:generate": "node scripts/run-with-env.mjs prisma generate",
    "prisma:migrate": "node scripts/run-with-env.mjs prisma migrate dev",
    "prisma:deploy": "node scripts/run-with-env.mjs prisma migrate deploy",
    "authorization:reconcile": "node scripts/run-with-env.mjs ts-node prisma/reconcile-authorization-registry.ts",
    "workspace:reconcile-starter": "node scripts/run-with-env.mjs ts-node prisma/reconcile-starter-workspaces.ts",
    "seed": "node scripts/run-with-env.mjs prisma db seed",
    "bootstrap:admin": "node scripts/run-with-env.mjs ts-node prisma/bootstrap-admin.ts",
    "openapi:generate": "ts-node src/generate-openapi.ts",
    "architecture:check": "node scripts/check-architecture.mjs",
    "authorization:registry-check": "node scripts/check-authorization-registry.mjs",
    "benchmark:authorization": "node scripts/run-with-env.mjs ts-node scripts/benchmark-authorization.ts"
  },
  "prisma": {
    "seed": "ts-node prisma/seed.ts"
  },
  "dependencies": {
    "@langchain/core": "^1.2.1",
    "@langchain/openai": "^1.5.3",
    "@lg-agent/contracts": "workspace:^",
    "@nestjs/common": "^10.0.0",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^10.0.0",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-express": "^10.0.0",
    "@nestjs/platform-socket.io": "^10.4.22",
    "@nestjs/schedule": "^6.1.3",
    "@nestjs/swagger": "^11.4.5",
    "@nestjs/terminus": "^11.1.1",
    "@nestjs/websockets": "^10.4.22",
    "@prisma/client": "^5.0.0",
    "@willsoto/nestjs-prometheus": "^6.1.0",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "bcryptjs": "^3.0.3",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "csv-stringify": "^6.8.1",
    "joi": "^18.2.3",
    "jsonwebtoken": "^9.0.3",
    "nestjs-cls": "^6.2.1",
    "nestjs-i18n": "^10.8.5",
    "nestjs-pino": "^4.6.1",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "passport-local": "^1.0.0",
    "pino-http": "^11.0.0",
    "pino-pretty": "^13.1.3",
    "prisma": "^5.0.0",
    "prom-client": "^15.1.3",
    "reflect-metadata": "^0.2.0",
    "rxjs": "^7.8.1",
    "socket.io": "^4.8.3",
    "swagger-ui-express": "^5.0.1",
    "typescript": "^5.1.3"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.0.0",
    "@nestjs/schematics": "^10.0.0",
    "@nestjs/testing": "^10.0.0",
    "@types/bcryptjs": "^3.0.0",
    "@types/express": "^4.17.17",
    "@types/jest": "^29.5.2",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^20.3.1",
    "@types/passport-jwt": "^4.0.1",
    "@types/passport-local": "^1.0.38",
    "@types/supertest": "^6.0.0",
    "jest": "^29.5.0",
    "source-map-support": "^0.5.21",
    "supertest": "^6.3.3",
    "ts-jest": "^29.1.0",
    "ts-loader": "^9.4.3",
    "ts-node": "^10.9.1",
    "tsconfig-paths": "^4.2.0",
    "yaml": "^2.9.0"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node"
  }
}
