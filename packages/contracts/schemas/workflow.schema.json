{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "lg-agent:schema:workflow",
  "title": "Workflow Configuration",
  "description": "Schema for Workflow execution (Pre-reserved)",
  "version": "1.0.0",
  "type": "object",
  "properties": {
    "steps": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": { "type": "string" },
          "action": { "type": "string" }
        },
        "required": ["name", "action"]
      }
    }
  },
  "additionalProperties": true
}
