{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "lg-agent:schema:env",
  "title": "Environment Configuration",
  "description": "Schema for Task Environment requirements",
  "version": "2.0.0",
  "type": "object",
  "properties": {
    "image": { "type": "string", "deprecated": true },
    "packages": { "type": "object", "additionalProperties": true },
    "node": { "type": ["boolean", "string"] },
    "java": { "type": ["boolean", "string"] },
    "python": { "type": ["boolean", "string"] },
    "docker": { "type": ["boolean", "string"] },
    "git": { "type": ["boolean", "string"] },
    "runtime": {
      "type": "object",
      "properties": {
        "language": { "enum": ["node", "java", "python", "go", "rust"] },
        "runtime": { "type": "string" },
        "version": { "type": "string", "minLength": 1 },
        "entry": { "type": "string", "minLength": 1 },
        "actions": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "properties": {
              "executable": { "type": "string", "minLength": 1 },
              "args": { "type": "array", "items": { "type": "string" } },
              "env": { "type": "object", "additionalProperties": { "type": "string" } },
              "workdir": { "type": "string" }
            },
            "required": ["executable", "args"],
            "additionalProperties": false
          }
        },
        "actionRequirements": {
          "type": "object",
          "properties": {
            "run": { "enum": ["required", "optional", "unsupported"] },
            "build": { "enum": ["required", "optional", "unsupported"] },
            "lint": { "enum": ["required", "optional", "unsupported"] },
            "test": { "enum": ["required", "optional", "unsupported"] }
          },
          "required": ["run", "build", "lint", "test"],
          "additionalProperties": false
        }
      },
      "required": ["language", "version", "entry"],
      "additionalProperties": false
    },
    "files": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "path": { "type": "string" },
          "content": { "type": "string" },
          "language": { "type": "string" },
          "readonly": { "type": "boolean" },
          "hidden": { "type": "boolean" }
        },
        "required": ["path", "content"],
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": false
}
