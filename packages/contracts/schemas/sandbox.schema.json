{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "lg-agent:schema:sandbox",
  "title": "Sandbox Configuration",
  "description": "Schema for Task Sandbox execution environment",
  "version": "1.0.0",
  "type": "object",
  "properties": {
    "image": { "type": "string" },
    "timeout": { "type": "number", "default": 300 },
    "resources": {
      "type": "object",
      "properties": {
        "cpu": { "type": "string" },
        "memory": { "type": "string" }
      }
    }
  },
  "required": ["image"],
  "additionalProperties": true
}
