{
  "name": "@lg-agent/contracts",
  "version": "1.0.0",
  "private": true,
  "description": "Shared contracts, schemas, and types for LG Agent",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./src/index.ts",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc && node -e \"require('fs').cpSync('schemas', 'dist/schemas', {recursive: true})\"",
    "dev": "tsc -w"
  },
  "devDependencies": {
    "typescript": "^5.6.3"
  }
}
