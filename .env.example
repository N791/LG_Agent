# ============================================================
# AI 沉浸式入职引擎 — 环境变量模板
# 复制此文件为 .env 并填写实际值
# ============================================================

# ── 应用 ──
NODE_ENV=development
APP_PORT=4000

# ── 数据库（PostgreSQL） ──
DATABASE_URL=postgresql://postgres:postgres@localhost:54322/lg_agent?schema=public
REDIS_URL=redis://localhost:6379
DATA_LIFECYCLE_ENABLED=true
DATA_LIFECYCLE_BATCH_SIZE=1000
WORKSPACE_VERSION_MAX_COUNT=50
WORKSPACE_VERSION_RETENTION_DAYS=90
CONVERSATION_RETENTION_DAYS=365
LLM_REQUEST_RETENTION_DAYS=180
LLM_AUDIT_RETENTION_DAYS=365
AUDIT_EVENT_RETENTION_DAYS=2555
CLIENT_LOG_RETENTION_DAYS=30
CLIENT_METRIC_RETENTION_DAYS=90
SUBMISSION_ARCHIVE_THRESHOLD_BYTES=262144

# ── 缓存（Redis） ──
REDIS_HOST=localhost
REDIS_PORT=16379
REDIS_PASSWORD=

# ── 对象存储（MinIO） ──
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
# Required: use deployment-specific credentials; never use MinIO defaults.
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_BUCKET=lg-agent

# ── 认证（JWT） ──
# Required: generate a unique cryptographically random value (at least 32 characters).
JWT_SECRET=
JWT_ALGORITHM=HS256
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# One-time administrator bootstrap (used only by `pnpm --filter @lg-agent/api bootstrap:admin`)
BOOTSTRAP_ADMIN_USERNAME=
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_ORGANIZATION_CODE=
BOOTSTRAP_ORGANIZATION_NAME=
BOOTSTRAP_PLATFORM_ADMIN=false

# ── AI / LLM ──
LLM_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_DEFAULT_MODEL=gpt-4o
RAG_ENABLED=true
RAG_VECTOR_STORE=memory
RAG_TOP_K=3
RAG_CHUNK_SIZE=1000
# Versioned retrieval rollout: LEGACY (instant rollback), SHADOW, or ACTIVE.
RETRIEVAL_ROLLOUT_MODE=LEGACY
# Comma-separated organization UUIDs. Organizations not listed always stay on LEGACY.
RETRIEVAL_ROLLOUT_ORGANIZATIONS=
RETRIEVAL_ROLLOUT_COURSES=
RETRIEVAL_ROLLOUT_USERS=
RETRIEVAL_DISABLED_QUERY_ROUTER=
RETRIEVAL_DISABLED_CODE_RETRIEVAL=
RETRIEVAL_DISABLED_PROGRESSIVE_DISCLOSURE=

# ── Sandbox（Docker） ──
SANDBOX_NODE_IMAGE=node:20-alpine@sha256:fb4cd12c85ee03686f6af5362a0b0d56d50c58a04632e6c0fb8363f609372293
# Example digests below are placeholders. Build, scan, and publish deploy/runtime-images first,
# then replace each digest before enabling that language.
SANDBOX_JAVA_IMAGE=eclipse-temurin:21-jdk@sha256:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa
SANDBOX_PYTHON_IMAGE=python:3.12-slim@sha256:bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb
SANDBOX_GO_IMAGE=golang:1.24-alpine@sha256:cccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccc
SANDBOX_RUST_IMAGE=rust:1.84-slim@sha256:dddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddd
SANDBOX_IMAGE_ALLOWLIST=node:20-alpine,eclipse-temurin:21-jdk,python:3.12-slim,golang:1.24-alpine,rust:1.84-slim
SANDBOX_ENABLED_LANGUAGES=node
SANDBOX_CPU_LIMIT=0.5
SANDBOX_MEMORY_LIMIT=256m
SANDBOX_TIMEOUT_MS=30000
SANDBOX_PIDS_LIMIT=128
SANDBOX_USER_CONCURRENCY=2
SANDBOX_ORG_CONCURRENCY=10
TEMPLATE_GIT_ALLOWED_HOSTS=github.com,gitlab.com
TEMPLATE_GIT_MAX_BYTES=10000000
TEMPLATE_GIT_MAX_FILES=5000

# ── 日志 ──
LOG_LEVEL=debug
# Sandbox adapters: local is permitted only outside production.
SANDBOX_EXECUTOR=docker
SANDBOX_IMAGE_PULL_SECRET=
