# ============================================================
# AI 沉浸式入职引擎 — 环境变量模板
# 复制此文件为 .env 并填写实际值
# ============================================================

# ── 应用 ──
NODE_ENV=development
APP_PORT=3000

# ── 数据库（PostgreSQL） ──
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/lg_agent?schema=public

# ── 缓存（Redis） ──
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ── 对象存储（MinIO） ──
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=lg-agent

# ── 认证（JWT） ──
JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=7200

# ── AI / LLM ──
LLM_PROVIDER=openai
LLM_API_KEY=
LLM_MODEL=gpt-4o
LLM_MAX_TOKENS=4096
LLM_TEMPERATURE=0.3

# ── Sandbox（Docker） ──
SANDBOX_IMAGE=node:20-slim
SANDBOX_CPU_LIMIT=1
SANDBOX_MEMORY_LIMIT=512m
SANDBOX_TIMEOUT=60000

# ── 日志 ──
LOG_LEVEL=debug
