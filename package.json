{
  "name": "lg-agent",
  "version": "0.1.0",
  "private": true,
  "description": "AI 沉浸式企业入职引擎 — Monorepo",
  "keywords": [
    "onboarding",
    "ai",
    "training",
    "enterprise"
  ],
  "license": "UNLICENSED",
  "scripts": {
    "prelint": "turbo run build --filter=@lg-agent/contracts --filter=@lg-agent/permission-react",
    "architecture:check": "node packages/api/scripts/check-architecture.mjs",
    "design:check": "node packages/api/scripts/check-design-consistency.mjs",
    "deployment:policy": "node packages/api/scripts/check-authorization-migration-safety.mjs",
    "db:init": "node packages/api/scripts/init-database.mjs",
    "dev": "turbo run dev --ui=tui",
    "build": "turbo run build",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint packages/*/src --fix",
    "format": "prettier --write \"packages/*/src/**/*.{ts,tsx,json,css,md}\"",
    "format:check": "prettier --check \"packages/*/src/**/*.{ts,tsx,json,css,md}\"",
    "typecheck": "tsc --noEmit -p packages/api/tsconfig.json && tsc --noEmit -p packages/web/tsconfig.json && tsc --noEmit -p packages/trainee-web/tsconfig.json && tsc --noEmit -p packages/cli/tsconfig.json",
    "test": "turbo run test",
    "test:watch": "turbo run test:watch",
    "test:e2e": "turbo run test:e2e",
    "test:cov": "turbo run test:cov",
    "prepare": "husky",
    "release": "changeset publish"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix --max-warnings 0",
      "prettier --write"
    ],
    "*.{json,md,css,yaml,yml}": [
      "prettier --write"
    ]
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.0",
    "@commitlint/cli": "^19.8.1",
    "@commitlint/config-conventional": "^19.8.1",
    "@eslint/js": "^9.39.4",
    "@typescript-eslint/eslint-plugin": "^8.33.1",
    "@typescript-eslint/parser": "^8.33.1",
    "eslint": "^9.28.0",
    "husky": "^9.1.7",
    "lint-staged": "^15.5.1",
    "playwright": "^1.61.1",
    "prettier": "^3.5.3",
    "puppeteer": "^25.3.0",
    "turbo": "^2.10.4",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.63.0"
  },
  "engines": {
    "node": ">=20.6.0",
    "pnpm": ">=9.0.0"
  },
  "pnpm": {
    "overrides": {
      "@nestjs/platform-express>multer": "2.2.0",
      "body-parser@1": "1.20.6",
      "brace-expansion@1": "1.1.18",
      "brace-expansion@2": "2.1.4",
      "brace-expansion@5": "5.0.9",
      "fast-uri@3": "3.1.5",
      "glob@10": "10.5.0",
      "js-yaml@3": "3.15.1",
      "js-yaml@4": "4.3.1",
      "multer": "2.2.0",
      "picomatch@4": "4.0.5",
      "qs": "6.15.2"
    }
  },
  "packageManager": "pnpm@9.15.9"
}
